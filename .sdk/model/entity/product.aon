# Entity: product

main: kit: entity: product: {

  alias: field: {}

  fields: [
    {
      name: "additives_tags"
      req: false
      short: "List of additives"
      type: "`$ARRAY`"
    }
    {
      name: "allergens"
      req: false
      short: "Allergens present in the product"
      type: "`$STRING`"
    }
    {
      name: "brands"
      req: false
      short: "Brands of the product"
      type: "`$STRING`"
    }
    {
      name: "categories"
      req: false
      short: "Categories the product belongs to"
      type: "`$STRING`"
    }
    {
